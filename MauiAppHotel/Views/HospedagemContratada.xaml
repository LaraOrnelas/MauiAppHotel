<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.HospedagemContratada"
             Title="HospedagemContratada"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="Black">

    <VerticalStackLayout VerticalOptions="CenterAndExpand" Padding="20" Spacing="10">

        <Label Text="{Binding QuartoSelecionado.Descricao}"
               TextColor="White" 
               FontFamily="PTSerif-Bold"
               FontSize="40"
               HorizontalTextAlignment="Center" />

        <Frame Margin="10">
            <HorizontalStackLayout>
                <HorizontalStackLayout>
                    <Label Text="Adultos:  " />
                    <Label Text="{Binding QntAdultos}" 
                           TextColor="{StaticResource Primary}" />
                </HorizontalStackLayout>

                <HorizontalStackLayout>
                    <Label Text="Crianças:  " />
                    <Label Text="{Binding QntCriancas}" 
                           TextColor="{StaticResource Primary}" />
                </HorizontalStackLayout>
            </HorizontalStackLayout>
        </Frame>

        <Frame Margin="10">
            <Grid ColumnDefinitions="*,*,*"
                  RowDefinitions="Auto, Auto">
                <Label Grid.Row="0" Grid.Column="0" Text="Check-in" />
                <Label Grid.Row="0" Grid.Column="1" Text="Check-out" />
                <Label Grid.Row="0" Grid.Column="2" Text="Estadia" />

                <Label Grid.Row="1" Grid.Column="0" 
                       Text="{Binding DataCheckin, StringFormat= '{}{0:dd/MM/yyyy}'}" 
                        TextColor="{StaticResource Primary}"/>
                <Label Grid.Row="1" Grid.Column="1"
                       Text="{Binding DataCheckout, StringFormat= '{}{0:dd/MM/yyyy}'}" 
                        TextColor="{StaticResource Primary}"/>
                <Label Grid.Row="1" Grid.Column="2" 
                       Text="{Binding Estadia}" 
                        TextColor="{StaticResource Primary}"/>
            </Grid>
        </Frame>

        <Frame Margin="10">
            <HorizontalStackLayout>
                <Label Text="Valor Total : " />
                <Label Text="{Binding ValorTotal, StringFormat= '{}{0:c}'}"  
                       TextColor="{StaticResource Primary}"/>
            </HorizontalStackLayout>
        </Frame>

        <Button Text="Voltar" HorizontalOptions="Center"
                Clicked="Button_Clicked" />

    </VerticalStackLayout>

</ContentPage>

    
   